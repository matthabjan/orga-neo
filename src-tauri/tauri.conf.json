{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orga-Neo",
  "version": "../package.json",
  "identifier": "io.github.matthabjan.organeo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orga-Neo",
        "width": 1360,
        "height": 900,
        "minWidth": 940,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; frame-src blob:; object-src blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMDBFQjc4MEUyMDdBRTIKUldUaWVpQU9lT3NBYnQrVENxRUhTV0kyajEvS2V4U2dqRDgvS2xzdjlEdHFKdW93MjVsZ3J3NksK",
      "endpoints": [
        "https://github.com/matthabjan/orga-neo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
